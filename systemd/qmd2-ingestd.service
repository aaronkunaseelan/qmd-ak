[Unit]
Description=qmd2 sole ingestion and store writer
After=network-online.target
Wants=network-online.target

[Service]
Slice=qmd2.slice
ExecStart=%h/.local/share/qmd2/venv/bin/python -m qmd2.ingestd
MemoryMax=2G
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
